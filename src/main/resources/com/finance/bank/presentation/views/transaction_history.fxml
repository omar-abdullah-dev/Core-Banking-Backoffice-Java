<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.finance.bank.presentation.controllers.TransactionHistoryController"
      styleClass="content-area"
      spacing="20">

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="12">
        <Label text="📜 Transaction History"
               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1A2B4A;" />
        <Region HBox.hgrow="ALWAYS" />
        <Label fx:id="txCountLabel" styleClass="badge, badge-blue"
               style="-fx-font-size: 12px; -fx-padding: 4 12;" />
        <Button text="📥 Export CSV" styleClass="btn-secondary"
                onAction="#handleExport" />
        <Button text="🔄 Refresh" styleClass="btn-secondary"
                onAction="#handleRefresh" />
    </HBox>

    <!-- Alert Container -->
    <VBox fx:id="alertContainer" spacing="8" />

    <!-- Filter Bar -->
    <HBox styleClass="card" style="-fx-padding: 14 20;" alignment="CENTER_LEFT" spacing="16">
        <!-- National ID Search -->
        <VBox spacing="4" minWidth="260">
            <Label text="CUSTOMER NATIONAL ID" style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #8899BB;" />
            <HBox spacing="8">
                <TextField fx:id="nationalIdFilter"
                           styleClass="form-field"
                           promptText="Enter National ID to filter"
                           HBox.hgrow="ALWAYS" />
                <Button text="Filter" styleClass="btn-primary"
                        onAction="#handleFilterByCustomer"
                        prefWidth="90" />
            </HBox>
        </VBox>

        <Separator orientation="VERTICAL" style="-fx-padding: 0 4;" />

        <!-- Type Filter -->
        <VBox spacing="4">
            <Label text="TYPE" style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #8899BB;" />
            <ComboBox fx:id="typeFilter" styleClass="form-combo"
                      onAction="#handleTypeFilter" prefWidth="140" />
        </VBox>

        <Region HBox.hgrow="ALWAYS" />

        <!-- Show All Button -->
        <Button text="Show All Transactions" styleClass="btn-secondary"
                onAction="#handleShowAll" />
    </HBox>

    <!-- Summary Cards -->
    <HBox spacing="16">
        <HBox styleClass="stat-card" spacing="14" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
            <StackPane styleClass="stat-icon-box, stat-icon-green">
                <Label text="⬇" style="-fx-font-size: 18px; -fx-text-fill: #1A7A4A;" />
            </StackPane>
            <VBox spacing="2">
                <Label fx:id="totalDepositsLabel" text="EGP 0.00" styleClass="stat-value"
                       style="-fx-font-size: 20px;" />
                <Label text="Total Deposits" styleClass="stat-label" />
            </VBox>
        </HBox>
        <HBox styleClass="stat-card" spacing="14" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
            <StackPane styleClass="stat-icon-box, stat-icon-gold">
                <Label text="⬆" style="-fx-font-size: 18px; -fx-text-fill: #B7791F;" />
            </StackPane>
            <VBox spacing="2">
                <Label fx:id="totalWithdrawalsLabel" text="EGP 0.00" styleClass="stat-value"
                       style="-fx-font-size: 20px;" />
                <Label text="Total Withdrawals" styleClass="stat-label" />
            </VBox>
        </HBox>
        <HBox styleClass="stat-card" spacing="14" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
            <StackPane styleClass="stat-icon-box, stat-icon-blue">
                <Label text="#" style="-fx-font-size: 18px; -fx-text-fill: #1E4D8C; -fx-font-weight: bold;" />
            </StackPane>
            <VBox spacing="2">
                <Label fx:id="txCountStat" text="0" styleClass="stat-value"
                       style="-fx-font-size: 20px;" />
                <Label text="Transactions" styleClass="stat-label" />
            </VBox>
        </HBox>
    </HBox>

    <!-- Transaction Table -->
    <VBox styleClass="card" VBox.vgrow="ALWAYS" >
        <TableView fx:id="transactionTable"
                   VBox.vgrow="ALWAYS"
                   style="-fx-background-radius: 0 0 12 12;">
            <placeholder>
                <Label text="No transactions found" style="-fx-text-fill: #6B7A99;" />
            </placeholder>
            <columns>
                <TableColumn fx:id="colType" text="Type" minWidth="110" maxWidth="130" />
                <TableColumn fx:id="colAmount" text="Amount (EGP)" minWidth="130" />
                <TableColumn fx:id="colBalance" text="Balance After" minWidth="130" />
                <TableColumn fx:id="colAccount" text="Account" minWidth="150" />
                <TableColumn fx:id="colEmployee" text="Performed By" minWidth="140" />
                <TableColumn fx:id="colRole" text="Role" minWidth="120" />
                <TableColumn fx:id="colTimestamp" text="Timestamp" minWidth="180" />
                <TableColumn fx:id="colTxId" text="Transaction ID" minWidth="260" />
            </columns>
        </TableView>
    </VBox>
</VBox>
