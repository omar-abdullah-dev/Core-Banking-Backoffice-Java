<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.finance.bank.presentation.controllers.DashboardController"
            prefWidth="1200" prefHeight="800">

    <!-- ═══════════════ LEFT SIDEBAR ═══════════════ -->
    <left>
        <VBox styleClass="sidebar">

            <!-- Sidebar Header / Brand -->
            <VBox styleClass="sidebar-header" spacing="2">
                <Label text="🏦 Finance Bank" styleClass="sidebar-logo" />
                <Label text="BACK OFFICE SYSTEM" styleClass="sidebar-subtitle" />
            </VBox>

            <!-- Navigation Sections -->
            <VBox VBox.vgrow="ALWAYS" spacing="2" style="-fx-padding: 12 0 0 0;">

                <!-- Overview Section -->
                <Label text="OVERVIEW" styleClass="sidebar-section-label" />
                <Button fx:id="navDashboard" text="📊  Dashboard"
                        styleClass="nav-button, active"
                        onAction="#showDashboard" maxWidth="Infinity" />

                <!-- Customer Management Section -->
                <Label fx:id="navSectionCustomers" text="CUSTOMERS" styleClass="sidebar-section-label" />
                <Button fx:id="navCreateCustomer" text="➕  Create Customer"
                        styleClass="nav-button"
                        onAction="#showCreateCustomer" maxWidth="Infinity" />
                <Button fx:id="navCustomerList" text="👥  Customer List"
                        styleClass="nav-button"
                        onAction="#showCustomerList" maxWidth="Infinity" />

                <!-- Account Section -->
                <Label fx:id="navSectionAccounts" text="ACCOUNTS" styleClass="sidebar-section-label" />
                <Button fx:id="navOpenAccount" text="💳  Open Account"
                        styleClass="nav-button"
                        onAction="#showOpenAccount" maxWidth="Infinity" />
                <Button fx:id="navAccountList" text="📋  Account List"
                        styleClass="nav-button"
                        onAction="#showAccountList" maxWidth="Infinity" />

                <!-- Transactions Section -->
                <Label fx:id="navSectionTransactions" text="TRANSACTIONS" styleClass="sidebar-section-label" />
                <Button fx:id="navDeposit" text="💰  Deposit"
                        styleClass="nav-button"
                        onAction="#showDeposit" maxWidth="Infinity" />
                <Button fx:id="navWithdraw" text="💸  Withdraw"
                        styleClass="nav-button"
                        onAction="#showWithdraw" maxWidth="Infinity" />
                <Button fx:id="navTransactionHistory" text="📜  Transaction History"
                        styleClass="nav-button"
                        onAction="#showTransactionHistory" maxWidth="Infinity" />

                <!-- Audit / Reports -->
                <Label fx:id="navSectionAudit" text="AUDIT &amp; REPORTS" styleClass="sidebar-section-label" />
                <Button fx:id="navAuditLog" text="🔍  Audit Log"
                        styleClass="nav-button"
                        onAction="#showAuditLog" maxWidth="Infinity" />

            </VBox>

            <!-- Bottom: Employee info + Logout -->
            <VBox style="-fx-border-color: #1E3055; -fx-border-width: 1 0 0 0; -fx-padding: 12 0 0 0;">
                <VBox style="-fx-padding: 8 16 8 16;" spacing="2">
                    <Label fx:id="sidebarEmployeeName"
                           style="-fx-text-fill: #C8D8F0; -fx-font-weight: bold; -fx-font-size: 13px;" />
                    <Label fx:id="sidebarEmployeeRole"
                           style="-fx-text-fill: #6B8AB8; -fx-font-size: 11px;" />
                </VBox>
                <Button text="⏻  Logout"
                        styleClass="nav-button"
                        onAction="#handleLogout"
                        style="-fx-text-fill: #FF7B72;"
                        maxWidth="Infinity" />
            </VBox>
        </VBox>
    </left>

    <!-- ═══════════════ MAIN CONTENT ═══════════════ -->
    <center>
        <VBox>
            <!-- Top Bar -->
            <HBox styleClass="top-bar" alignment="CENTER_LEFT" spacing="12">
                <VBox spacing="2">
                    <Label fx:id="pageTitle" text="Dashboard" styleClass="page-title" />
                    <Label fx:id="pageBreadcrumb" text="Finance Bank / Overview" styleClass="page-breadcrumb" />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />

                <!-- Employee Chip -->
                <HBox styleClass="employee-chip" alignment="CENTER" spacing="10">
                    <Label fx:id="topBarEmployeeName" styleClass="employee-name-label" />
                    <Label fx:id="topBarRoleBadge" styleClass="employee-role-badge" />
                </HBox>
            </HBox>

            <!-- Content Container: switches between views -->
            <ScrollPane VBox.vgrow="ALWAYS"
                        fitToWidth="true"
                        styleClass="scroll-pane">
                <StackPane fx:id="contentContainer"
                           style="-fx-background-color: #F0F2F5;"
                           minHeight="600" />
            </ScrollPane>
        </VBox>
    </center>

</BorderPane>
