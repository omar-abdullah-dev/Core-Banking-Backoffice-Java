<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.finance.bank.presentation.controllers.TransactionFormController"
      styleClass="content-area"
      spacing="20">

    <!-- Page Header -->
    <HBox alignment="CENTER_LEFT" spacing="12">
        <Label fx:id="pageHeaderLabel"
               text="💰 Deposit"
               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1A2B4A;" />
    </HBox>

    <!-- Alert Container -->
    <VBox fx:id="alertContainer" spacing="8" />

    <HBox spacing="20">
        <!-- Transaction Form Card -->
        <VBox styleClass="card" HBox.hgrow="ALWAYS" spacing="0">
            <VBox styleClass="card-header">
                <Label fx:id="formTitle" text="Deposit Funds" styleClass="card-title" />
                <Label text="Find the customer account and enter the transaction amount."
                       style="-fx-font-size: 12px; -fx-text-fill: #6B7A99;" />
            </VBox>
            <VBox styleClass="card-body" spacing="20">

                <!-- Step 1: Customer -->
                <VBox spacing="10" style="-fx-background-color: #F8F9FC; -fx-background-radius: 8; -fx-padding: 14; -fx-border-color: #DDE3EE; -fx-border-radius: 8; -fx-border-width: 1;">
                    <Label text="STEP 1 — FIND CUSTOMER"
                           style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #8899BB;" />
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <TextField fx:id="nationalIdField"
                                   styleClass="form-field"
                                   promptText="Enter customer National ID"
                                   HBox.hgrow="ALWAYS" />
                        <Button text="Search"
                                styleClass="btn-primary"
                                onAction="#handleSearchCustomer"
                                prefWidth="90" />
                    </HBox>
                    <HBox fx:id="customerFoundBox" visible="false" managed="false"
                          spacing="12" alignment="CENTER_LEFT"
                          style="-fx-background-color: #E8F5EE; -fx-background-radius: 6; -fx-padding: 10 14; -fx-border-color: #A3D9B8; -fx-border-radius: 6; -fx-border-width: 1;">
                        <Label text="✓" style="-fx-font-size: 16px; -fx-text-fill: #1A7A4A;" />
                        <Label fx:id="foundCustomerName"
                               style="-fx-font-weight: bold; -fx-text-fill: #155E39;" />
                    </HBox>
                </VBox>

                <!-- Step 2: Select Account -->
                <VBox fx:id="accountSelectionBox" visible="false" managed="false"
                      spacing="10" style="-fx-background-color: #F8F9FC; -fx-background-radius: 8; -fx-padding: 14; -fx-border-color: #DDE3EE; -fx-border-radius: 8; -fx-border-width: 1;">
                    <Label text="STEP 2 — SELECT ACCOUNT"
                           style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #8899BB;" />
                    <ComboBox fx:id="accountCombo"
                              styleClass="form-combo"
                              promptText="Select account..."
                              onAction="#handleAccountSelected"
                              maxWidth="Infinity" />
                    <!-- Account Balance Display -->
                    <HBox fx:id="balanceBox" visible="false" managed="false"
                          spacing="20" alignment="CENTER_LEFT"
                          style="-fx-background-color: #EBF0FA; -fx-background-radius: 6; -fx-padding: 10 14; -fx-border-color: #C0D0EC; -fx-border-radius: 6; -fx-border-width: 1;">
                        <VBox spacing="2">
                            <Label text="CURRENT BALANCE" style="-fx-font-size: 10px; -fx-text-fill: #6B7A99;" />
                            <Label fx:id="currentBalanceLabel"
                                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1A3461;" />
                        </VBox>
                        <VBox spacing="2">
                            <Label text="ACCOUNT TYPE" style="-fx-font-size: 10px; -fx-text-fill: #6B7A99;" />
                            <Label fx:id="accountTypeLabel"
                                   style="-fx-font-size: 13px; -fx-text-fill: #1A2B4A;" />
                        </VBox>
                    </HBox>
                </VBox>

                <!-- Step 3: Amount -->
                <VBox fx:id="amountBox" visible="false" managed="false"
                      spacing="10" style="-fx-background-color: #F8F9FC; -fx-background-radius: 8; -fx-padding: 14; -fx-border-color: #DDE3EE; -fx-border-radius: 8; -fx-border-width: 1;">
                    <Label text="STEP 3 — ENTER AMOUNT"
                           style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #8899BB;" />
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="EGP"
                               style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #6B7A99; -fx-padding: 0 4 0 0;" />
                        <TextField fx:id="amountField"
                                   styleClass="form-field"
                                   promptText="0.00"
                                   HBox.hgrow="ALWAYS"
                                   style="-fx-font-size: 18px; -fx-font-weight: bold;" />
                    </HBox>
                    <Label fx:id="feeLabel"
                           text=""
                           style="-fx-font-size: 11px; -fx-text-fill: #8899BB;" />
                    <!-- Note/Tip -->
                    <Label fx:id="tipLabel"
                           text="💡 Tip: For withdrawals, a 1% fee is applied. E.g., withdrawing EGP 1,000 deducts EGP 1,010 total."
                           style="-fx-font-size: 10px; -fx-text-fill: #6B7A99; -fx-wrap-text: true;"
                           wrapText="true" />

                    <HBox spacing="12">
                        <Button fx:id="actionButton"
                                text="Confirm Deposit"
                                styleClass="btn-success"
                                onAction="#handleTransaction"
                                prefWidth="160" />
                        <Button text="Cancel"
                                styleClass="btn-secondary"
                                onAction="#handleReset" />
                    </HBox>
                </VBox>

            </VBox>
        </VBox>

        <!-- Receipt / Result Panel -->
        <VBox minWidth="280" maxWidth="280" spacing="12">
            <!-- Transaction Receipt -->
            <VBox fx:id="receiptCard" styleClass="card" visible="false" managed="false" spacing="0">
                <VBox styleClass="card-header"
                      style="-fx-background-color: #1A7A4A; -fx-background-radius: 12 12 0 0;">
                    <Label fx:id="receiptTitle" text="✓  Transaction Successful"
                           style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: white;" />
                </VBox>
                <VBox styleClass="card-body" spacing="10">
                    <HBox spacing="0">
                        <VBox spacing="2" HBox.hgrow="ALWAYS">
                            <Label text="TRANSACTION ID" style="-fx-font-size: 9px; -fx-text-fill: #8899BB;" />
                            <Label fx:id="receiptTxId" style="-fx-font-size: 10px; -fx-text-fill: #1A2B4A;" />
                        </VBox>
                    </HBox>
                    <Separator />
                    <HBox>
                        <VBox spacing="2" HBox.hgrow="ALWAYS">
                            <Label text="AMOUNT" style="-fx-font-size: 9px; -fx-text-fill: #8899BB;" />
                            <Label fx:id="receiptAmount" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1A7A4A;" />
                        </VBox>
                    </HBox>
                    <HBox>
                        <VBox spacing="2" HBox.hgrow="ALWAYS">
                            <Label text="NEW BALANCE" style="-fx-font-size: 9px; -fx-text-fill: #8899BB;" />
                            <Label fx:id="receiptBalance" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1A3461;" />
                        </VBox>
                    </HBox>
                    <HBox>
                        <VBox spacing="2" HBox.hgrow="ALWAYS">
                            <Label text="PROCESSED BY" style="-fx-font-size: 9px; -fx-text-fill: #8899BB;" />
                            <Label fx:id="receiptEmployee" style="-fx-font-size: 12px; -fx-text-fill: #1A2B4A;" />
                        </VBox>
                    </HBox>
                    <HBox>
                        <VBox spacing="2" HBox.hgrow="ALWAYS">
                            <Label text="TIMESTAMP" style="-fx-font-size: 9px; -fx-text-fill: #8899BB;" />
                            <Label fx:id="receiptTimestamp" style="-fx-font-size: 11px; -fx-text-fill: #1A2B4A;" />
                        </VBox>
                    </HBox>
                </VBox>
            </VBox>

            <!-- Info Card -->
            <VBox styleClass="card" spacing="0">
                <VBox styleClass="card-header">
                    <Label text="Fee Information" styleClass="card-title" />
                </VBox>
                <VBox styleClass="card-body" spacing="8">
                    <Label fx:id="feeInfoDeposit" text="Deposits: No fee" style="-fx-font-size: 12px; -fx-text-fill: #1A2B4A;" />
                    <Label fx:id="feeInfoWithdraw" text="Withdrawals: 1% fee on amount" style="-fx-font-size: 12px; -fx-text-fill: #1A2B4A;" />
                    <Separator />
                    <!-- Dynamic calculation display -->
                    <VBox fx:id="feeCalculationBox" spacing="4">
                        <Label fx:id="feeCalcAmount" text="Amount: EGP 0.00" style="-fx-font-size: 11px; -fx-text-fill: #1A2B4A;" />
                        <Label fx:id="feeCalcFee" text="Fee (1%): EGP 0.00" style="-fx-font-size: 11px; -fx-text-fill: #C0392B;" />
                        <Label fx:id="feeCalcTotal" text="Total deducted: EGP 0.00" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #1A3461;" />
                    </VBox>
                </VBox>
            </VBox>
        </VBox>
    </HBox>
</VBox>
