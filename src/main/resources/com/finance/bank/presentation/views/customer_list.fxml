<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.finance.bank.presentation.controllers.CustomerListController"
      styleClass="content-area"
      spacing="20">

    <!-- Header Row -->
    <HBox alignment="CENTER_LEFT" spacing="12">
        <Label text="👥 Customer List"
               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1A2B4A;" />
        <Region HBox.hgrow="ALWAYS" />
        <Label fx:id="customerCountLabel"
               styleClass="badge, badge-blue"
               style="-fx-font-size: 12px; -fx-padding: 4 12;" />
        <Button text="🔄 Refresh"
                styleClass="btn-secondary"
                onAction="#handleRefresh" />
    </HBox>

    <!-- Alert Container -->
    <VBox fx:id="alertContainer" spacing="8" />

    <!-- Search + Filter Bar -->
    <HBox styleClass="card" style="-fx-padding: 14 20;" alignment="CENTER_LEFT" spacing="12">
        <TextField fx:id="searchField"
                   styleClass="form-field"
                   promptText="🔍  Search by name or National ID..."
                   prefWidth="320"
                   onKeyReleased="#handleSearch" />
        <Region HBox.hgrow="ALWAYS" />
        <Label text="Sort by:" style="-fx-font-size: 12px; -fx-text-fill: #6B7A99;" />
        <ComboBox fx:id="sortCombo"
                  styleClass="form-combo"
                  onAction="#handleSort" />
    </HBox>

    <!-- Customer Table -->
    <VBox styleClass="card" VBox.vgrow="ALWAYS" spacing="0">
        <TableView fx:id="customerTable"
                   VBox.vgrow="ALWAYS"
                   style="-fx-background-radius: 0 0 12 12;">
            <placeholder>
                <Label text="No customers found" style="-fx-text-fill: #6B7A99;" />
            </placeholder>
            <columns>
                <TableColumn fx:id="colIndex" text="#" minWidth="50" maxWidth="60" />
                <TableColumn fx:id="colSystemId" text="System ID" minWidth="220" />
                <TableColumn fx:id="colName" text="Customer Name" minWidth="180" />
                <TableColumn fx:id="colNationalId" text="National ID" minWidth="150" />
                <TableColumn fx:id="colAccounts" text="Accounts" minWidth="100" maxWidth="120" />
                <TableColumn fx:id="colActions" text="Actions" minWidth="100" maxWidth="130" />
            </columns>
        </TableView>
    </VBox>

</VBox>
