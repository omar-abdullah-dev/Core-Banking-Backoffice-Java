<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<StackPane xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.finance.bank.presentation.controllers.LoginController"
           styleClass="login-root"
           prefWidth="1100" prefHeight="720">

    <!-- Background gradient -->
    <VBox styleClass="login-bg-pattern" />

    <StackPane>
        <VBox alignment="CENTER">
            <VBox fx:id="loginPanel" styleClass="login-panel" spacing="0">

                <!-- Logo + Title -->
                <VBox alignment="CENTER" spacing="10">
                    <StackPane alignment="CENTER" styleClass="login-logo-box">
                        <Label text="&#127974;" style="-fx-font-size: 26px;" />
                    </StackPane>
                    <Label text="Finance Bank" styleClass="login-title" />
                    <Label text="Back Office Management System" styleClass="login-subtitle" />
                </VBox>

                <Region prefHeight="28" />

                <!-- Alert Container -->
                <VBox fx:id="alertContainer" spacing="8" />
                <Region fx:id="alertSpacer" prefHeight="0" />

                <!-- Login Form -->
                <VBox spacing="18">
                    <VBox spacing="6">
                        <Label text="USERNAME" styleClass="form-label" />
                        <TextField fx:id="usernameField"
                                   styleClass="form-field"
                                   promptText="Enter your username"
                                   onAction="#handleLogin" />
                    </VBox>

                    <VBox spacing="6">
                        <Label text="PASSWORD" styleClass="form-label" />
                        <PasswordField fx:id="passwordField"
                                       styleClass="form-field"
                                       promptText="Enter your password"
                                       onAction="#handleLogin" />
                    </VBox>

                    <Region prefHeight="4" />

                    <Button fx:id="loginButton"
                            text="Sign In"
                            styleClass="btn-primary"
                            onAction="#handleLogin"
                            maxWidth="Infinity"
                            prefHeight="44" />
                </VBox>

                <Region prefHeight="20" />

                <!-- Credentials Hint -->
                <VBox alignment="CENTER" spacing="8">
                    <Label text="Available Credentials"
                           style="-fx-font-size: 11px; -fx-text-fill: #8899BB; -fx-font-weight: bold;" />
                    <VBox spacing="4" alignment="CENTER">
                        <HBox alignment="CENTER" spacing="8">
                            <Label text="ahmed / ahmedPass!"
                                   style="-fx-font-size: 11px; -fx-text-fill: #6B7A99; -fx-background-color: #F5F7FA; -fx-background-radius: 4; -fx-padding: 3 8;" />
                            <Label text="Manager"
                                   style="-fx-font-size: 10px; -fx-text-fill: #1A3461; -fx-background-color: #E0E8F5; -fx-background-radius: 4; -fx-padding: 3 8; -fx-font-weight: bold;" />
                        </HBox>
                        <HBox alignment="CENTER" spacing="8">
                            <Label text="mohamed / mohamedPass!"
                                   style="-fx-font-size: 11px; -fx-text-fill: #6B7A99; -fx-background-color: #F5F7FA; -fx-background-radius: 4; -fx-padding: 3 8;" />
                            <Label text="Teller"
                                   style="-fx-font-size: 10px; -fx-text-fill: #155E39; -fx-background-color: #E0F5EA; -fx-background-radius: 4; -fx-padding: 3 8; -fx-font-weight: bold;" />
                        </HBox>
                        <HBox alignment="CENTER" spacing="8">
                            <Label text="omar / omarPass!"
                                   style="-fx-font-size: 11px; -fx-text-fill: #6B7A99; -fx-background-color: #F5F7FA; -fx-background-radius: 4; -fx-padding: 3 8;" />
                            <Label text="Customer Service"
                                   style="-fx-font-size: 10px; -fx-text-fill: #6B2C91; -fx-background-color: #F3E8FF; -fx-background-radius: 4; -fx-padding: 3 8; -fx-font-weight: bold;" />
                        </HBox>
                    </VBox>
                    <Label text="(Also: manager/manager123  teller/teller123  cs/cs123456)"
                           style="-fx-font-size: 10px; -fx-text-fill: #B0BACC;" />
                </VBox>

            </VBox>
        </VBox>
    </StackPane>
</StackPane>
